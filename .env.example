# Execution safety: leave both values unchanged for Phase 2.
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Angel One SmartAPI credentials. Never commit the populated .env file.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Comma-separated EXCHANGE:TOKEN[:SYMBOL] entries.
# Example only; validate current identities from the local cache before use.
# NSE_CM:3045:SBIN-EQ,NSE_CM:99926000:Nifty 50
ANGEL_MARKET_SUBSCRIPTIONS=
ANGEL_SUBSCRIPTION_MODE=QUOTE
ANGEL_CORRELATION_ID=intraday01

DATABASE_URL=sqlite:///trading_bot.db
DATABASE_BUSY_TIMEOUT_MS=5000
MARKET_TIMEZONE=Asia/Kolkata
MARKET_DATA_STALE_AFTER_SECONDS=5

WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5
WEBSOCKET_RECONNECT_INITIAL_DELAY_SECONDS=1
WEBSOCKET_RECONNECT_MULTIPLIER=2
WEBSOCKET_RECONNECT_MAX_DELAY_SECONDS=30
WEBSOCKET_STABLE_CONNECTION_SECONDS=30

TICK_INGESTION_QUEUE_CAPACITY=10000
TICK_INGESTION_BATCH_SIZE=250
TICK_INGESTION_FLUSH_INTERVAL_SECONDS=0.05
TICK_INGESTION_SHUTDOWN_TIMEOUT_SECONDS=10

INSTRUMENT_MASTER_CACHE_PATH=data/cache/angel_instruments.json
INSTRUMENT_MASTER_MAX_AGE_DAYS=7
INTRADAY_UNIVERSE_CACHE_PATH=data/cache/angel_nse_intraday.json
INTRADAY_UNIVERSE_MAX_AGE_SECONDS=28800
NIFTY500_CACHE_PATH=data/cache/nifty500.json
NIFTY500_MAX_AGE_DAYS=7
REFERENCE_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5
REFERENCE_DOWNLOAD_READ_TIMEOUT_SECONDS=30
REFERENCE_DOWNLOAD_MAX_ATTEMPTS=3

# Leave blank to scan the cached NIFTY 500 intersection. Use 5-20 symbols for smoke tests.
SCANNER_SYMBOLS=
NIFTY_BENCHMARK_TRADING_SYMBOL=NIFTY 50
HISTORICAL_BOOTSTRAP_LOOKBACK_DAYS=30
HISTORICAL_BOOTSTRAP_MINIMUM_SESSIONS=15
HISTORICAL_PROVIDER=angel
HISTORICAL_FALLBACK_ENABLED=false
HISTORICAL_REQUEST_DELAY_SECONDS=0.5
HISTORICAL_REQUEST_MAX_ATTEMPTS=3
HISTORICAL_RETRY_INITIAL_DELAY_SECONDS=1
HISTORICAL_RETRY_MAX_DELAY_SECONDS=8
SCAN_REPLAY_WARNING_TICK_COUNT=500000
SCAN_REPLAY_WARNING_SECONDS=10
SCAN_REPLAY_HARD_TICK_LIMIT=2000000
SCANNER_PROJECTION_STALE_AFTER_SECONDS=5
MARKET_DATA_RECOVERY_CONSECUTIVE_TICKS=3
RELATIVE_VOLUME_LOOKBACK_SESSIONS=15
RELATIVE_VOLUME_MINIMUM_SESSIONS=10
RELATIVE_VOLUME_THRESHOLD=1.5
OPENING_RANGE_MINUTES=15
SCANNER_BREAKOUT_PROXIMITY_PCT=0.25
MAX_VWAP_DISTANCE_ATR=1.5
REGIME_MOMENTUM_THRESHOLD_PCT=0.05
REGIME_SLOPE_LOOKBACK_CANDLES=3
SCANNER_WEIGHT_VWAP=2
SCANNER_WEIGHT_EMA=2
SCANNER_WEIGHT_RELATIVE_VOLUME=2
SCANNER_WEIGHT_RELATIVE_STRENGTH=2
SCANNER_WEIGHT_OPENING_RANGE=1
SCANNER_WEIGHT_MARKET_REGIME=1

RISK_PER_TRADE_PCT=0.003
MAX_DAILY_LOSS_PCT=0.009
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=4
MAX_CONSECUTIVE_LOSSES=3
MAX_CAPITAL_UTILIZATION_PCT=1.0

# Broker-free PAPER simulation. These settings never enable live orders.
PAPER_STARTING_EQUITY=1000000
PAPER_ENTRY_START_TIME=09:30:00
PAPER_LAST_ENTRY_TIME=14:45:00
PAPER_SQUARE_OFF_TIME=15:15:00
PAPER_SLIPPAGE_BPS=5
PAPER_TICK_PARTICIPATION_PCT=0.10
PAPER_FIRST_PARTIAL_PCT=0.50
PAPER_SECOND_PARTIAL_PCT=0.25
PAPER_STOP_BUFFER_ATR=0.10
PAPER_MINIMUM_STOP_TICKS=2
PAPER_MAXIMUM_STOP_ATR=1.50

# Estimated Angel One / NSE cash-intraday costs used only in PAPER reports.
# Decimal fractions: 0.001 = 0.1%. Verify against current contract notes.
PAPER_COST_SCHEDULE_AS_OF=2026-10-21
PAPER_BROKERAGE_RATE=0.001
PAPER_BROKERAGE_MINIMUM_PER_ORDER=5
PAPER_BROKERAGE_MAXIMUM_PER_ORDER=20
PAPER_EXCHANGE_TRANSACTION_RATE=0.000030699
PAPER_STT_SELL_RATE=0.00025
PAPER_IPFT_RATE=0.000000001
PAPER_SEBI_TURNOVER_RATE=0.000001
PAPER_STAMP_DUTY_BUY_RATE=0.00003
PAPER_GST_RATE=0.18
